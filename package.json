{
	"name": "kongcheck",
	"version": "1.3.0",
	"description": "CLI tool for detecting Kong Konnect route collisions and shadowing",
	"keywords": [
		"analyze",
		"audit",
		"cli",
		"kong",
		"konnect",
		"router"
	],
	"homepage": "https://github.com/paambaati/kongcheck#readme",
	"bugs": "https://github.com/paambaati/kongcheck/issues",
	"license": "MIT",
	"author": {
		"name": "GP",
		"email": "me@httgp.com",
		"url": "https://httgp.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paambaati/kongcheck.git"
	},
	"scripts": {
		"start": "bun run src/cli.ts",
		"test": "vitest run src/",
		"test:coverage": "vitest run src/ --coverage",
		"typecheck": "tsc --noEmit",
		"codegen:version": "node scripts/generate-version.js",
		"build": "bun build --compile --minify --outfile dist/kongcheck src/cli.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.0.0",
		"@valibot/to-json-schema": "1.7.1",
		"cac": "7.0.0",
		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@types/bun": "1.4.1",
		"@types/node": "26.4.1",
		"@vitest/coverage-v8": "5.0.0",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	}
}
