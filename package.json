{
	"name": "kongcheck",
	"version": "1.2.0",
	"description": "CLI tool for detecting Kong Konnect route collisions and shadowing",
	"keywords": [
		"analyze",
		"audit",
		"cli",
		"kong",
		"konnect",
		"router"
	],
	"homepage": "https://github.com/paambaati/kongcheck#readme",
	"bugs": "https://github.com/paambaati/kongcheck/issues",
	"license": "MIT",
	"author": {
		"name": "GP",
		"email": "me@httgp.com",
		"url": "https://httgp.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paambaati/kongcheck.git"
	},
	"scripts": {
		"start": "bun run src/cli.ts",
		"test": "vitest run src/",
		"test:coverage": "vitest run src/ --coverage",
		"typecheck": "tsc --noEmit",
		"build": "perry compile src/cli.ts -o dist/kongcheck --compile-packages cac,zod,@modelcontextprotocol/sdk",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"cac": "7.0.0",
		"tiny-relative-date": "2.0.2",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "^20.11.0",
		"@vitest/coverage-v8": "^2.1.0",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "^2.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "bun",
			"onFail": "error"
		}
	}
}
